# =============================================================================
# TuniVerse .gitignore (Python FastAPI + Next.js Monorepo)
# =============================================================================

# --- Environment Variables & Secrets (CRITICAL) ---
.env
*.env
backend/.env
backend/*.env
frontend/.env
frontend/*.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!.env.example
!backend/.env.example
!frontend/.env.example

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
.venv*/
venv*/
env*/

# --- Testing & Quality Tools ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml

# --- Node.js & Frontend ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Data Files (Datasets & Checkpoints) ---
data/raw/
data/processed/
*.log

# --- IDEs & System Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
